{
  "elegans-guardrails": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "./ai/bin/fe-core env-guard ."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "./ai/bin/fe-core check-edit"
          }
        ]
      }
    ]
  }
}
